# ─── Site vitrine Campus Food (https://campusfood.app) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://campusfood.app

# Demandes « Devenir restaurant partenaire » (serveur uniquement).
# Clé PUBLIQUE (publishable) du projet Supabase : la base n'autorise que l'insertion (RLS). Jamais de clé service_role ici.
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clé publique>
# Facultatif : utilisée par la page publique /pay (valeur par défaut = le projet de production).
# NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co

# Magasins d'applications : à renseigner UNIQUEMENT avec les adresses définitives des fiches publiées.
# Tant qu'elles sont vides, les badges affichent « Bientôt disponible ».
# NEXT_PUBLIC_ANDROID_PLAY_URL=https://play.google.com/store/apps/details?id=cd.campusfood.app
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/<nom>/id<numéro>
# NEXT_PUBLIC_ANDROID_APK_URL=https://...   # installation directe optionnelle

# Contact : à activer seulement quand la boîte est créée et vérifiée.
# NEXT_PUBLIC_CONTACT_EMAIL_READY=true      # affiche contact@campusfood.app
# NEXT_PUBLIC_WHATSAPP_NUMBER=243XXXXXXXXX  # numéro professionnel, chiffres uniquement, indicatif inclus

# Réseaux sociaux officiels (adresses https complètes ; seuls les réseaux renseignés apparaissent)
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_TIKTOK=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
